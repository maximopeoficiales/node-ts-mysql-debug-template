# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (MySQL)
# Estos valores coinciden con docker-compose.yml
DB_HOST=localhost
DB_PORT=3306
DB_USER=authuser
DB_PASSWORD=authpass
DB_NAME=auth_service_db

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=1h

# DynamoDB Configuration (LocalStack)
# Puerto 4567 para evitar conflicto con LocalStack local en 4566
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:4567
DYNAMODB_SESSIONS_TABLE=auth-sessions

# Para producción (AWS real):
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# Comentar o eliminar DYNAMODB_ENDPOINT para usar AWS real
