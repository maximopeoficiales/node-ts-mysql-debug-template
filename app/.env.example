# ========================================
# 🔧 Server Configuration
# ========================================
PORT=3000
NODE_ENV=development

# ========================================
# 🗄️ Database Configuration (PostgreSQL + Prisma)
# ========================================
# Prisma Database URL (PostgreSQL)
# Nota: Esta es la única variable de DB necesaria con Prisma
DATABASE_URL="postgresql://authuser:authpass@localhost:5432/auth_service_db?schema=public"

# ========================================
# 🔐 JWT Configuration
# ========================================
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=1h

# ========================================
# 🔴 Redis Configuration (Cache & Rate Limiting)
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL=3600

# ========================================
# 🔶 DynamoDB Configuration (Sessions)
# ========================================
# LocalStack (Development)
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:4567
DYNAMODB_SESSIONS_TABLE=auth-sessions
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Production (AWS Real)
# Descomentar y usar valores reales en producción:
# AWS_ACCESS_KEY_ID=your-real-access-key
# AWS_SECRET_ACCESS_KEY=your-real-secret-key
# Comentar DYNAMODB_ENDPOINT para usar AWS real

# ========================================
# ⚡ Rate Limiting Configuration (Opcional)
# ========================================
# Si no se especifican, se usan los valores por defecto

# Registro: 3 requests por hora
RATE_LIMIT_REGISTER_POINTS=3
RATE_LIMIT_REGISTER_DURATION=3600

# Login fallido: 5 requests por 15 minutos
RATE_LIMIT_LOGIN_POINTS=5
RATE_LIMIT_LOGIN_DURATION=900

# General: 100 requests por hora
RATE_LIMIT_GENERAL_POINTS=100
RATE_LIMIT_GENERAL_DURATION=3600

# Moderado: 300 requests por 15 minutos
RATE_LIMIT_MODERATE_POINTS=300
RATE_LIMIT_MODERATE_DURATION=900

# Estricto: 10 requests por hora
RATE_LIMIT_STRICT_POINTS=10
RATE_LIMIT_STRICT_DURATION=3600

# ========================================
# 📊 Performance Monitoring
# ========================================
# Umbral para considerar una request "lenta" (en milisegundos)
SLOW_REQUEST_THRESHOLD=1000

# ========================================
# 📨 Event Bus Configuration
# ========================================
# Tipo de Event Bus: 'sns' | 'sqs' | 'noop'
# - 'noop': No envía eventos (desarrollo/testing)
# - 'sqs': AWS SQS (cola simple)
# - 'sns': AWS SNS (pub/sub, puede distribuir a múltiples destinos)
EVENT_BUS_TYPE=noop

# AWS Endpoint (LocalStack para desarrollo - puerto 4567 según docker-compose.yml)
AWS_ENDPOINT=http://localhost:4567

# SNS Configuration (si EVENT_BUS_TYPE=sns)
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:auth-events

# SQS Configuration (si EVENT_BUS_TYPE=sqs)
SQS_QUEUE_URL=http://localhost:4567/000000000000/auth-events-queue

# Nota: AWS_REGION, AWS_ACCESS_KEY_ID y AWS_SECRET_ACCESS_KEY
# se reutilizan de la configuración de DynamoDB arriba
